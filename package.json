{
  "name": "codigos-postales-mx",
  "version": "1.0.0",
  "description": "Un SDK para la API de Códigos Postales de México, escrito en TypeScript.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "format": "prettier --write src/**/*.ts tests/**/*.ts",
    "docs": "typedoc"
  },
  "keywords": [
    "mexico",
    "codigo postal",
    "api",
    "sdk",
    "sepomex",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ripper2hl/codigos-postales-mx.git"
  },
  "author": "Israel Perales",
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
